# Paths for one Mac. Copy to machine.env and adjust.
# The checkout of the product's front-end repository that the agents read.
APP_REPO="$HOME/Projects/app"
# The folder in APP_REPO that holds @playwright/test, for scripts/screenshot.mjs.
PLAYWRIGHT_DIR="$APP_REPO"
# The saved session for screenshots of the app. scripts/save-session.sh writes it.
# Keep it outside the repository.
SESSION_FILE="$HOME/.lewitt/session.json"
