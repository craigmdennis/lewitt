# Pointers for one Mac. scripts/point-at.sh copies this file to lewitt.env and
# writes APP_REPO. Git ignores lewitt.env. Write paths with $HOME.
# The main checkout of the product's front-end repository.
APP_REPO="$HOME/Projects/app"
# The folder that holds the app repository's worktrees, one per project. Use the
# folder the repository already uses, if it has one: git worktree list.
WORKTREES_DIR="$HOME/Projects/app-worktrees"
# The backend repository the engineer reads, if any. Leave empty for none.
BACKEND_REPO=""
# The folder in APP_REPO that holds @playwright/test, for scripts/screenshot.mjs.
PLAYWRIGHT_DIR="$APP_REPO"
# The saved session for screenshots of the app. scripts/save-session.sh writes it.
# Keep it outside every repository.
SESSION_FILE="$HOME/.lewitt/session.json"
