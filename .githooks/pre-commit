#!/bin/sh
# Block a commit where the Now view's version in plugin.json and in
# hooks/build.ts differ. Claude Code reads the first, and the pane's footer
# shows the second.
manifest=$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' plugins/now-view/.claude-plugin/plugin.json)
built=$(sed -n "s/^export const VERSION = '\([^']*\)'.*/\1/p" plugins/now-view/hooks/build.ts)
if [ "$manifest" != "$built" ]; then
  echo "The Now view's version is $manifest in plugin.json and $built in hooks/build.ts. Set both to the same version." >&2
  exit 1
fi

# Block a commit that adds a term from this Mac's denylist, so company content
# stays out of this public repository. The terms are in
# $HOME/.config/lewitt/denylist, one per line, matched without case, which
# /lewitt:start fills for each product. Lines that start with # are comments.
list="$HOME/.config/lewitt/denylist"
[ -f "$list" ] || exit 0
terms=$(grep -v '^[[:space:]]*#' "$list" | grep -v '^[[:space:]]*$' || true)
[ -n "$terms" ] || exit 0
added=$(git diff --cached --unified=0 --no-color | grep '^+' | grep -v '^+++' || true)
hits=$(printf '%s\n' "$added" | grep -n -i -F "$(printf '%s\n' "$terms")" || true)
if [ -n "$hits" ]; then
  echo "This commit adds company terms from $list:" >&2
  printf '%s\n' "$hits" | cut -c1-200 >&2
  echo "Move the company content into the product's .lewitt/, or reword it, then commit again." >&2
  exit 1
fi
